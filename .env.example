# =============================================================================
# LedgerFlow — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — Primary (Groq / Qwen3.8-27B)
# -----------------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=groq
LLM_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# LLM — Fallback (Google Gemini 3.8 Flash)
# -----------------------------------------------------------------------------
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here

# LLM request timeout in seconds
LLM_TIMEOUT_SECONDS=30

# Maximum retries on LLM failure before marking run as FAILED
LLM_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/ledgerflow

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Options: "local" (dev only) | "supabase"
STORAGE_BACKEND=local

# Local storage path (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=./storage/uploads

# Supabase storage (used when STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_STORAGE_BUCKET=ledgerflow-invoices

# -----------------------------------------------------------------------------
# File Upload Limits
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
MAX_PAGE_COUNT=20

# -----------------------------------------------------------------------------
# Business Rules — Tolerance Policy (Decision D-004)
# -----------------------------------------------------------------------------
# PO variance tolerance: percentage of remaining PO value (e.g. 1.0 = 1%)
TOLERANCE_PERCENT=1.0

# PO variance tolerance: absolute cap in INR (e.g. 500 = ₹500)
TOLERANCE_CAP_INR=500

# Invoice arithmetic rounding allowance in INR (e.g. 1.00 = ₹1)
ROUNDING_ALLOWANCE_INR=1.00

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend URL — used for CORS allow-list
FRONTEND_URL=http://localhost:3000

# Secret key for any signed tokens (use a random 32+ character string)
SECRET_KEY=change_this_to_a_random_secret_key

# -----------------------------------------------------------------------------
# OCR (Tesseract fallback)
# -----------------------------------------------------------------------------
# Path to tessdata directory (leave empty to use system default)
TESSDATA_PREFIX=

# Tesseract language(s) to load
TESSERACT_LANG=eng
